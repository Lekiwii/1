# Bot Telegram : crée-le avec @BotFather et colle le token ici
TELEGRAM_TOKEN=
# Ton identifiant Telegram (envoie /start au bot, il te l'affiche). Seul cet utilisateur reçoit les alertes.
TELEGRAM_CHAT_ID=

# eBay Developer Program (https://developer.ebay.com) : clés "Production" (App ID + Cert ID)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplaces à scanner, séparées par des virgules (EBAY_FR, EBAY_DE, EBAY_GB, EBAY_US, EBAY_IT, EBAY_ES)
EBAY_MARKETPLACES=EBAY_FR,EBAY_DE

# Optionnel : cotes gradées PSA/BGS/CGC de PriceCharting (abonnement payant, https://www.pricecharting.com/api-documentation)
PRICECHARTING_TOKEN=
# Taux USD -> EUR pour convertir les cotes PriceCharting
USD_TO_EUR=0.92
GBP_TO_EUR=1.17
# Sans PriceCharting, la cote = médiane des annonces comparables, minorée de ce pourcentage
# (les prix demandés sont plus hauts que les prix réellement vendus)
COMPS_DISCOUNT_PCT=10

# Règles de rentabilité
MIN_PROFIT_EUR=30
MIN_ROI_PCT=15
# Commission de la plateforme de revente (eBay ~13 %) + frais de paiement
SELL_FEE_PCT=13
# Coût d'envoi sécurisé quand tu revends (suivi + assurance)
SELL_SHIPPING_EUR=8
# Vendeurs acceptés
MIN_SELLER_FEEDBACK_PCT=98
MIN_SELLER_FEEDBACK_SCORE=50
# Fourchette de prix d'achat
MIN_PRICE_EUR=20
MAX_PRICE_EUR=2000

# Fréquence du scan automatique (minutes)
SCAN_INTERVAL_MIN=15
DB_PATH=pokedeals.sqlite3
